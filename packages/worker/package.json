{
  "name": "@bingmail/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "postal-mime": "^2.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260525.0",
    "bun-types": "^1.3.14",
    "typescript": "^5.8.3",
    "wrangler": "^4.19.0"
  },
  "scripts": {
    "dev": "bun ./scripts/wrangler-dev.ts",
    "deploy": "wrangler deploy --cwd ../..",
    "test": "bun test",
    "typecheck": "bunx tsc -p tsconfig.json",
    "db:migrate": "bun ./scripts/db-migrate.ts",
    "db:migrate:remote": "bun ./scripts/db-migrate.ts --remote",
    "db:seed:dev": "bunx wrangler d1 execute bingmail --local --yes --cwd ../.. --file ../db/seeds/dev.sql",
    "db:reset:local": "bun ./scripts/db-reset-local.ts"
  }
}
