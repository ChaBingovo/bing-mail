{
  "name": "@bingmail/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "postal-mime": "^2.4.3"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "wrangler": "^4.19.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "bunx tsc -p tsconfig.json",
    "db:migrate": "wrangler d1 execute bingmail --file ../db/migrations/0001_init.sql",
    "db:seed:dev": "wrangler d1 execute bingmail --file ../db/seeds/dev.sql"
  }
}
